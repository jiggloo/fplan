# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Test & tooling caches
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# IDE / OS
.idea/
.vscode/
.DS_Store

# Local config — the real file is per-machine; the committed example documents it.
/.fplan-config.yaml

# Ephemeral working artifacts.
# Keep the directories themselves visible in a fresh clone (via their
# tracked .gitkeep), but never track the generated files inside them.
/maps/*
!/maps/.gitkeep
/runs/*
!/runs/.gitkeep

# examples/runs/ holds committed example run *manifests* — curated reference
# material, like examples/maps/. The stage artifacts a run generates (rates,
# layout, execution) are ephemeral, so only each run's manifest.yaml is tracked.
/examples/runs/*
!/examples/runs/*/
/examples/runs/*/*
!/examples/runs/*/manifest.yaml
